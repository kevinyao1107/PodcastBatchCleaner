<Window x:Class="PodcastBatchCleanerWpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:PodcastBatchCleanerWpf.Controls" Title="音訊工作台" Width="1180" Height="760" MinWidth="980" MinHeight="640" Background="#090B10" Foreground="#EEF2F7" Loaded="Window_Loaded" Closing="Window_Closing" FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B0B0B" />
    <SolidColorBrush x:Key="PanelBrush" Color="#151515" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="#1C1C1C" />
    <SolidColorBrush x:Key="BorderBrushDark" Color="#363636" />
    <SolidColorBrush x:Key="TextBrush" Color="#EEF2F7" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9AA4B2" />
    <SolidColorBrush x:Key="AccentBrush" Color="#36C2A6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4AD8BC" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1F9D87" />
    <SolidColorBrush x:Key="ButtonBrush" Color="#242424" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#2E3335" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#1A1E20" />
    <SolidColorBrush x:Key="InputBrush" Color="#101010" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#203A36" />
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="{StaticResource ButtonBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ButtonPressedBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#667085" />
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="MinHeight" Value="31" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="{StaticResource InputBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TextBox}">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="{StaticResource InputBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="8">
                      <TextBlock Text="⌄" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" IsHitTestVisible="False" Margin="10,4,30,4" VerticalAlignment="Center" />
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="#1C1C1C" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="8" Padding="4">
                  <ScrollViewer CanContentScroll="True">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="OptionBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="OptionBorder" Property="Background" Value="#303030" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="OptionBorder" Property="Background" Value="{StaticResource SelectionBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid>
              <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="{StaticResource AccentBrush}" Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" Height="2" VerticalAlignment="Center" /></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="20" Height="20" Focusable="False">
                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{StaticResource AccentBrush}" CornerRadius="8" Margin="2" /></ControlTemplate></Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="#45494B" Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" Height="2" VerticalAlignment="Center" /></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="12" />
      <Setter Property="Background" Value="#191A1C" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <Track.DecreaseRepeatButton><RepeatButton x:Name="DecreasePage" Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb x:Name="ScrollThumb" MinHeight="20"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#555A5E" CornerRadius="4" Margin="3" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton x:Name="IncreasePage" Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="12" /><Setter Property="Width" Value="Auto" />
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                <Setter TargetName="DecreasePage" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" />
                <Setter TargetName="IncreasePage" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
                <Setter TargetName="ScrollThumb" Property="MinHeight" Value="0" /><Setter TargetName="ScrollThumb" Property="MinWidth" Value="20" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TabItem}">
            <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="#07100E" />
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True" />
                  <Condition Property="IsSelected" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Separator">
      <Setter Property="Background" Value="{StaticResource BorderBrushDark}" />
    </Style>
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,18,0,10" />
    </Style>
    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
      <Setter Property="Margin" Value="0,12,0,6" />
    </Style>
    <Style x:Key="MetaTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <Style TargetType="GridViewColumnHeader">
      <Setter Property="Background" Value="#0F141E" />
      <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
      <Setter Property="Padding" Value="8,7" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style TargetType="ListView">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style TargetType="ListViewItem">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ListViewItem}">
            <Border x:Name="RowBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Margin="6,2" Padding="{TemplateBinding Padding}">
              <GridViewRowPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RowBorder" Property="Background" Value="#1B2330" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource SelectionBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <DockPanel Background="{StaticResource AppBackgroundBrush}">
    <Border DockPanel.Dock="Top" Background="#151719" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1" Padding="18,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <WrapPanel>
          <TextBlock FontSize="16" Margin="0,0,22,4" VerticalAlignment="Center" Text="音訊工作台" FontWeight="SemiBold" />
          <Button Click="SelectFolder_Click" Content="選取資料夾" IsEnabled="{Binding CanStartWork}" />
          <Button Click="SaveWork_Click" Content="保存工作" IsEnabled="{Binding CanStartWork}" />
          <Button Click="LoadWork_Click" Content="恢復工作" IsEnabled="{Binding CanStartWork}" />
        </WrapPanel>
        <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Text="{Binding CurrentFolderText}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedTextBrush}" />
        <WrapPanel Grid.Column="2" HorizontalAlignment="Right">
          <Button Click="ProcessSelected_Click" IsEnabled="{Binding CanExportSelection}" Content="{Binding ExportSelectedText}" Background="#25282A" BorderBrush="#3A3E41" Foreground="{StaticResource TextBrush}" ToolTip="{Binding OutputScopeText}" />
          <Button Click="ProcessAll_Click" IsEnabled="{Binding CanExportAll}" Content="{Binding ExportAllText}" Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="#07100E" />
          <Button Click="CancelProcessing_Click" Content="取消" IsEnabled="{Binding IsProcessing}" />
        </WrapPanel>
      </Grid>
    </Border>
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Margin="14,8" Text="{Binding ProcessingToolsText}" Visibility="{Binding HasProcessingReport, Converter={StaticResource BooleanToVisibilityConverter}}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProcessingToolsText}" Foreground="{StaticResource MutedTextBrush}" />
      <Border x:Name="ProcessingWarningBanner" Background="#282315" BorderBrush="#6B5529" BorderThickness="0,1,0,1" Padding="14,8" Visibility="{Binding HasProcessingWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Expander Header="{Binding ProcessingWarningSummary}" Foreground="#F4C96B">
          <TextBox Margin="0,8,0,0" MaxHeight="120" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding ProcessingWarningsText, Mode=OneWay}" />
        </Expander>
      </Border>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Height="38" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,1,0,0" Padding="12,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedTextBrush}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
          <TextBlock Width="220" VerticalAlignment="Center" Text="{Binding CurrentProcessingFileText}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedTextBrush}" />
          <ProgressBar Width="180" Height="10" Margin="10,0,8,0" Minimum="0" Maximum="100" Value="{Binding ProcessingProgress}" />
          <TextBlock Width="42" VerticalAlignment="Center" Text="{Binding ProcessingProgressText}" TextAlignment="Right" Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>
      </Grid>
    </Border>
    <Border BorderThickness="0,1,0,0" Padding="18,10" Background="#151719" DockPanel.Dock="Bottom" BorderBrush="#303235" x:Name="PersistentPlayer">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="190" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button Click="Play_Click" Content="▶︎" FontFamily="Segoe UI Symbol" Width="38" Padding="0" MinHeight="34" Margin="0,0,6,0" AutomationProperties.Name="播放" ToolTip="播放" />
          <Button Click="Pause_Click" Content="Ⅱ" FontFamily="Segoe UI Symbol" Width="38" Padding="0" MinHeight="34" Margin="0,0,6,0" AutomationProperties.Name="暫停" ToolTip="暫停" />
          <Button Click="Stop_Click" Content="■" Width="38" Padding="0" MinHeight="34" Margin="0,0,6,0" AutomationProperties.Name="停止" ToolTip="停止" />
        </StackPanel>
        <TextBlock Margin="12,0" Text="{Binding PlaybackContextText}" TextWrapping="NoWrap" Foreground="{StaticResource MutedTextBrush}" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding PlaybackContextText}" />
        <ComboBox Margin="0" SelectedIndex="{Binding PlaybackSourceIndex, Mode=TwoWay}" SelectionChanged="PlaybackSource_SelectionChanged" Grid.Column="2" x:Name="PlaybackSourceSelector">
          <ComboBoxItem Content="播放原始音檔" />
          <ComboBoxItem Content="播放處理後音檔" />
          <ComboBoxItem Content="播放上次整集成品" />
          <ComboBoxItem Content="播放單項效果比較" />
        </ComboBox>
        <Grid Grid.ColumnSpan="4" Grid.Row="1" Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="48" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding PlaybackPositionText}" Foreground="{StaticResource MutedTextBrush}" Grid.Column="0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding PlaybackDurationText}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" TextAlignment="Right" />
          <Slider x:Name="PositionSlider" Height="24" MinHeight="24" Margin="8,0" Minimum="0" Maximum="1" PreviewMouseDown="PositionSlider_PreviewMouseDown" PreviewMouseUp="PositionSlider_PreviewMouseUp" ValueChanged="PositionSlider_ValueChanged" Grid.Column="1" ToolTip="播放位置" />
        </Grid>
        <WrapPanel Margin="12,0,0,0" Grid.Column="3" VerticalAlignment="Center">
          <Button Click="PreviewSelected_Click" Content="30 秒試聽" IsEnabled="{Binding CanExportSelection}" Margin="0,0,6,0" Padding="10,6" ToolTip="依目前完整設定產生選取音檔的 30 秒試聽。" />
          <Button Click="CompareSelected_Click" Content="A/B 比較" IsEnabled="{Binding CanExportSelection}" Margin="0,0,6,0" Padding="10,6" />
        </WrapPanel>
      </Grid>
    </Border>
    <Grid Margin="0" x:Name="WorkspaceGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.6*" MinWidth="500" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" MinWidth="400" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#111213" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0" CornerRadius="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Padding="18,14" Background="#111213" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1" CornerRadius="0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="錄音檔案" />
              <Button Grid.Column="1" MinHeight="28" Padding="0" Click="MoveSelectedUp_Click" IsEnabled="{Binding CanStartWork}" Content="↑" Width="30" Margin="0,0,6,0" FontSize="16" AutomationProperties.Name="上移" ToolTip="上移" />
              <Button Grid.Column="2" MinHeight="28" Padding="0" Click="MoveSelectedDown_Click" IsEnabled="{Binding CanStartWork}" Content="↓" Width="30" Margin="0,0,6,0" FontSize="16" AutomationProperties.Name="下移" ToolTip="下移" />
              <Button Grid.Column="3" MinHeight="28" Padding="0" Click="OpenSelectedFolder_Click" Content="↗" Width="30" Margin="0,0,6,0" FontSize="16" AutomationProperties.Name="開原檔位置" ToolTip="開原檔位置" />
              <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="{Binding FileCountText}" />
            </Grid>
          </Border>
          <ListView x:Name="AudioList" IsEnabled="{Binding CanStartWork}" Grid.Row="1" AllowDrop="True" ItemsSource="{Binding AudioFiles}" SelectionMode="Extended" SelectionChanged="AudioList_SelectionChanged" PreviewMouseLeftButtonDown="AudioList_PreviewMouseLeftButtonDown" MouseMove="AudioList_MouseMove" Drop="AudioList_Drop" MouseDoubleClick="AudioList_MouseDoubleClick" SizeChanged="AudioList_SizeChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="音檔" Width="300">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Margin="10,0,8,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding FileName}" ToolTip="{Binding FilePath}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="76" Header="長度" DisplayMemberBinding="{Binding DurationText}" />
                <GridViewColumn Width="104" Header="狀態">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Status}" ToolTip="{Binding ProcessingDetailsText}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
          <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasNoAudioFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="尚無音檔" FontSize="16" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,14" />
            <Button Content="選取資料夾" Click="SelectFolder_Click" IsEnabled="{Binding CanStartWork}" HorizontalAlignment="Center" />
          </StackPanel>
          <Border BorderBrush="#303235" Grid.Row="2" BorderThickness="0,1,0,0" IsEnabled="{Binding CanExportSelection}" Padding="18,14" Background="#17191B" x:Name="SelectedFileInspector" Visibility="{Binding HasSelectedAudioItem, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
              <TextBlock Margin="0,0,0,12" TextTrimming="CharacterEllipsis" Text="{Binding SelectedAudioItem.FileName}" FontWeight="SemiBold" ToolTip="目前音檔；下方欄位只修改這個檔案。" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                  <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="12" Text="開始（秒）" Margin="0,0,0,6" />
                  <TextBox Text="{Binding SelectedAudioItem.TrimStartText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="64" x:Name="SelectedTrimStartTextBox" ToolTip="開始秒數或 mm:ss；留空從開頭開始。" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                  <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="12" Text="結束（秒）" Margin="0,0,0,6" />
                  <TextBox Text="{Binding SelectedAudioItem.TrimEndText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="64" x:Name="SelectedTrimEndTextBox" ToolTip="結束秒數或 mm:ss；留空直到結尾。" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0">
                  <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="12" Text="輸出檔名" Margin="0,0,0,6" />
                  <TextBox Text="{Binding SelectedAudioItem.CustomOutputFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="64" x:Name="SelectedOutputNameTextBox" ToolTip="留空使用原檔名加 _processed；只影響目前音檔。" />
                </StackPanel>
              </Grid>
              <TextBlock Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" FontSize="12" Text="{Binding SelectedAudioItem.ProcessedFileName}" Margin="0,8,0,0" ToolTip="{Binding SelectedAudioItem.ProcessedPath}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
      <Border Grid.Column="2" Background="#191A1C" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0" CornerRadius="0" Padding="18,12">
        <TabControl x:Name="EditorTabs">
          <TabItem Header="快速處理" IsEnabled="{Binding CanStartWork}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,6,8,8">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="處理模板" Margin="0,10,0,8" />
                <UniformGrid Columns="2" Margin="0,0,0,2">
                  <Button HorizontalAlignment="Stretch" Margin="0,0,8,6" Click="ApplyPodcastPreset_Click" Content="一般 Podcast" />
                  <Button HorizontalAlignment="Stretch" Margin="0,0,0,6" Click="ApplyRoomTonePreset_Click" Content="空間音重" />
                  <Button HorizontalAlignment="Stretch" Margin="0,0,8,6" Click="ApplyThinVoicePreset_Click" Content="聲音偏薄" />
                  <Button HorizontalAlignment="Stretch" Margin="0,0,0,6" Click="ApplyTrimOnlyPreset_Click" Content="只剪輯" />
                </UniformGrid>
                <CheckBox Content="A/B 等音量比較" IsChecked="{Binding MatchComparisonLoudness, Mode=TwoWay}" />
                <CheckBox Content="移除空白段落" IsChecked="{Binding RemoveSilence}" />
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="空拍超過多久刪除（0.1 - 10 秒）" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="88" />
                  </Grid.ColumnDefinitions>
                  <Slider x:Name="SilenceSecondsSlider" VerticalAlignment="Center" Minimum="0.1" Maximum="10" TickFrequency="0.1" SmallChange="0.1" LargeChange="1" IsSnapToTickEnabled="True" Value="{Binding SilenceSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBox Grid.Column="1" VerticalAlignment="Center" HorizontalContentAlignment="Right" Margin="8,0,0,0" Text="{Binding SilenceSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.0}" />
                </Grid>
                <Expander Margin="0,10,0,0" HorizontalAlignment="Stretch" Header="空拍進階設定" x:Name="SilenceAdvanced">
                  <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="空拍判定門檻 dBFS" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="88" />
                      </Grid.ColumnDefinitions>
                      <Slider VerticalAlignment="Center" Minimum="-80" Maximum="-5" TickFrequency="1" Value="{Binding SilenceThresholdDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                      <TextBox Grid.Column="1" VerticalAlignment="Center" HorizontalContentAlignment="Right" Margin="8,0,0,0" Text="{Binding SilenceThresholdDb, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0}" />
                    </Grid>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="剪除前後保留秒數（0 - 0.5）" />
                    <TextBox Text="{Binding SilencePaddingSeconds, UpdateSourceTrigger=LostFocus, StringFormat=0.00}" />
                  </StackPanel>
                </Expander>
                <TextBlock Text="音量與響度" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="音量增益 dB" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="88" />
                  </Grid.ColumnDefinitions>
                  <Slider VerticalAlignment="Center" Minimum="-24" Maximum="24" TickFrequency="0.5" SmallChange="0.5" LargeChange="3" IsSnapToTickEnabled="True" Value="{Binding VolumeGainDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBox Grid.Column="1" VerticalAlignment="Center" HorizontalContentAlignment="Right" Margin="8,0,0,0" Text="{Binding VolumeGainDb, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.0}" />
                </Grid>
                <CheckBox Margin="0,12,0,0" VerticalContentAlignment="Center" Content="響度標準化" IsChecked="{Binding NormalizeLoudness, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="目標響度 LUFS" />
                <ComboBox ItemsSource="{Binding LoudnessTargets}" SelectedItem="{Binding LoudnessTarget}" IsEnabled="{Binding NormalizeLoudness}" />
                <CheckBox Margin="0,10,0,0" VerticalContentAlignment="Center" Content="防爆音 Limiter" IsChecked="{Binding EnableLimiter, Mode=TwoWay}" />
                <Expander Margin="0,18,0,8" HorizontalAlignment="Stretch" Header="管理預設" x:Name="PresetManager" ToolTip="保存目前設定，或匯入／匯出 SoundLab JSON 預設。專用處理效果不會等效轉換。">
                  <StackPanel>
                    <TextBox Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" />
                    <ComboBox ItemsSource="{Binding PortablePresets}" SelectedItem="{Binding SelectedPortablePreset}" DisplayMemberPath="Name" />
                    <WrapPanel>
                      <Button Content="保存目前" Click="SavePortablePreset_Click" />
                      <Button Content="套用" Click="ApplyPortablePreset_Click" />
                      <Button Content="刪除" Click="DeletePortablePreset_Click" />
                      <Button Content="匯入 JSON" Click="ImportPortablePresets_Click" />
                      <Button Content="匯出 JSON" Click="ExportPortablePresets_Click" />
                    </WrapPanel>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="AI / 修復" IsEnabled="{Binding CanStartWork}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,6,8,8">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="單項效果比較" />
                <ComboBox x:Name="CleanupEffectSelector" SelectedIndex="{Binding SelectedCleanupEffect, Mode=TwoWay}">
                  <ComboBoxItem Content="降噪（FFmpeg）" />
                  <ComboBoxItem Content="空間音 / 箱音" />
                  <ComboBoxItem Content="殘響 / 尾音抑制" />
                  <ComboBoxItem Content="人聲增厚" />
                </ComboBox>
                <WrapPanel Margin="0,8,0,0">
                  <Button Content="產生 30 秒比較" Click="CompareCleanupEffect_Click" IsEnabled="{Binding CanExportSelection}" />
                  <Button Content="原音對照" Click="PlayCleanupBypass_Click" IsEnabled="{Binding CanPlayEffectPreview}" ToolTip="不套用清理效果，僅對齊響度。" />
                  <Button Content="單項效果" Click="PlayCleanupEffect_Click" IsEnabled="{Binding CanPlayEffectPreview}" />
                </WrapPanel>
                <TextBlock Text="{Binding EffectPreviewText}" TextWrapping="Wrap" Style="{StaticResource MetaTextStyle}" />
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="聲音補強" />
                <CheckBox Margin="0,0,0,0" VerticalContentAlignment="Center" Content="統一降噪" IsChecked="{Binding EnableDenoise, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="降噪強度（AI / 基本模式）" />
                <ComboBox x:Name="DenoiseStrengthSelector" IsEnabled="{Binding IsDenoiseStrengthEnabled}" SelectedIndex="{Binding DenoiseStrengthIndex, Mode=TwoWay}">
                  <ComboBoxItem Content="輕度" />
                  <ComboBoxItem Content="標準" />
                  <ComboBoxItem Content="強力" />
                </ComboBox>
                <CheckBox Margin="0,10,0,0" VerticalContentAlignment="Center" Content="減少空間音" IsChecked="{Binding ReduceRoomTone, Mode=TwoWay}" />
                <CheckBox Margin="0,10,0,0" VerticalContentAlignment="Center" Content="空間感抑制" IsChecked="{Binding ReduceReverb, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="空間感抑制強度" />
                <Grid IsEnabled="{Binding IsReverbReductionEnabled}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="88" />
                  </Grid.ColumnDefinitions>
                  <Slider VerticalAlignment="Center" Minimum="0.2" Maximum="1" TickFrequency="0.1" SmallChange="0.1" LargeChange="0.2" IsSnapToTickEnabled="True" Value="{Binding ReverbReductionAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBox Grid.Column="1" VerticalAlignment="Center" HorizontalContentAlignment="Right" Margin="8,0,0,0" Text="{Binding ReverbReductionAmount, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.00}" />
                </Grid>
                <Expander x:Name="CleanupTuningExpander" Header="進階清理參數" Margin="0,16,0,8">
                  <StackPanel Margin="0,8,4,0">
                    <CheckBox Content="使用細調參數" IsChecked="{Binding EnableAdvancedCleanup, Mode=TwoWay}" />
                    <StackPanel IsEnabled="{Binding EnableAdvancedCleanup}">
                      <TextBlock Style="{StaticResource FieldLabelStyle}" Text="傳統降噪量 dB" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="1" Maximum="30" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding FineDenoiseDb, Mode=TwoWay}" />
                        <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding FineDenoiseDb, Mode=TwoWay, StringFormat=0.0}" />
                      </Grid>
                      <CheckBox Margin="0,10,0,0" Content="自動追蹤底噪" IsChecked="{Binding TrackNoise, Mode=TwoWay}" />
                      <TextBlock Style="{StaticResource FieldLabelStyle}" Text="噪音底線 dBFS" ToolTip="追蹤開啟時為初始值；關閉時維持設定值。" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="-70" Maximum="-20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding NoiseFloorDb, Mode=TwoWay}" />
                        <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding NoiseFloorDb, Mode=TwoWay, StringFormat=0}" />
                      </Grid>
                      <TextBlock Style="{StaticResource FieldLabelStyle}" Text="空間音低切 Hz" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="40" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding RoomHighpassHz, Mode=TwoWay}" />
                        <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding RoomHighpassHz, Mode=TwoWay, StringFormat=0}" />
                      </Grid>
                      <TextBlock Style="{StaticResource FieldLabelStyle}" Text="箱音抑制中心 Hz" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="150" Maximum="600" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding RoomFrequencyHz, Mode=TwoWay}" />
                        <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding RoomFrequencyHz, Mode=TwoWay, StringFormat=0}" />
                      </Grid>
                      <TextBlock Style="{StaticResource FieldLabelStyle}" Text="箱音最大削減 dB" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="2" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding RoomReductionDb, Mode=TwoWay}" />
                        <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding RoomReductionDb, Mode=TwoWay, StringFormat=0.0}" />
                      </Grid>
                      <TextBlock Style="{StaticResource FieldLabelStyle}" Text="尾音衰減門檻 dBFS" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="-60" Maximum="-25" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding TailThresholdDb, Mode=TwoWay}" />
                        <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding TailThresholdDb, Mode=TwoWay, StringFormat=0.0}" />
                      </Grid>
                      <TextBlock Style="{StaticResource FieldLabelStyle}" Text="尾音釋放 ms" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="100" Maximum="800" TickFrequency="25" IsSnapToTickEnabled="True" Value="{Binding TailReleaseMs, Mode=TwoWay}" />
                        <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding TailReleaseMs, Mode=TwoWay, StringFormat=0}" />
                      </Grid>
                    </StackPanel>
                    <Button Content="重設細調" Margin="0,10,0,0" Click="ResetCleanupTuning_Click" />
                  </StackPanel>
                </Expander>
                <CheckBox Margin="0,10,0,0" VerticalContentAlignment="Center" Content="人聲增厚 EQ" IsChecked="{Binding EnhanceVoiceEq, Mode=TwoWay}" />
                <StackPanel IsEnabled="{Binding EnhanceVoiceEq}" Visibility="{Binding EnhanceVoiceEq, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <TextBlock Text="厚度 160 Hz（0～6 dB）" Style="{StaticResource FieldLabelStyle}" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="75" />
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="0" Maximum="6" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding VoiceThicknessDb, Mode=TwoWay}" />
                    <TextBox Grid.Column="1" Text="{Binding VoiceThicknessDb, Mode=TwoWay}" />
                  </Grid>
                  <TextBlock Text="清晰度 3200 Hz（0～4 dB）" Style="{StaticResource FieldLabelStyle}" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="75" />
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="0" Maximum="4" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding VoiceClarityDb, Mode=TwoWay}" />
                    <TextBox Grid.Column="1" Text="{Binding VoiceClarityDb, Mode=TwoWay}" />
                  </Grid>
                  <CheckBox Content="輕度壓縮" IsChecked="{Binding UseVoiceCompression, Mode=TwoWay}" />
                  <Button Content="重設人聲音色" Click="ResetVoiceTuning_Click" />
                </StackPanel>
                <CheckBox Margin="0,14,0,0" Content="三頻 EQ" IsChecked="{Binding EnableThreeBandEq, Mode=TwoWay}" />
                <StackPanel x:Name="ThreeBandEqControls" IsEnabled="{Binding EnableThreeBandEq}" Visibility="{Binding EnableThreeBandEq, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <TextBlock Style="{StaticResource FieldLabelStyle}" Text="低頻 140 Hz（−12～12 dB）" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="75" />
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="-12" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding LowEqDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding LowEqDb, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.0}" />
                  </Grid>
                  <TextBlock Style="{StaticResource FieldLabelStyle}" Text="中頻 1.1 kHz（−12～12 dB）" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="75" />
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="-12" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding MidEqDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding MidEqDb, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.0}" />
                  </Grid>
                  <TextBlock Style="{StaticResource FieldLabelStyle}" Text="高頻 8.5 kHz（−12～12 dB）" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="75" />
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="-12" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding HighEqDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding HighEqDb, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.0}" />
                  </Grid>
                </StackPanel>
                <CheckBox Margin="0,14,0,0" Content="齒音抑制（7.2 kHz）" IsChecked="{Binding EnableDeEsser, Mode=TwoWay}" />
                <StackPanel x:Name="DeEsserControls" IsEnabled="{Binding EnableDeEsser}" Visibility="{Binding EnableDeEsser, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <TextBlock Style="{StaticResource FieldLabelStyle}" Text="抑制量（0～100%）" />
                  <Slider Minimum="0" Maximum="100" Value="{Binding DeEsserAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBox Text="{Binding DeEsserAmount, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0}" />
                </StackPanel>
                <Expander Margin="0,18,0,8" Header="AI 工具與外部音檔" HorizontalAlignment="Stretch">
                  <StackPanel>
                    <CheckBox Margin="0,0,0,0" VerticalContentAlignment="Center" Content="使用 AI 處理後音檔" IsChecked="{Binding UseAiProcessedAudio, Mode=TwoWay}" />
                    <WrapPanel Margin="0,8,0,0">
                      <Button Click="ChooseAiAudioFolder_Click" Content="AI 音檔資料夾" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding AiAudioFolderText}" TextWrapping="Wrap" />
                    <CheckBox Margin="0,10,0,0" VerticalContentAlignment="Center" Content="DeepFilterNet AI 降噪" IsChecked="{Binding EnableDeepFilterNet, Mode=TwoWay}" />
                    <CheckBox x:Name="DeepFilterPostFilterCheckBox" Margin="18,8,0,0" VerticalContentAlignment="Center" Content="DeepFilterNet PostFilter" IsEnabled="{Binding EnableDeepFilterNet}" IsChecked="{Binding EnableDeepFilterNetPostFilter, Mode=TwoWay}" />
                    <CheckBox x:Name="AiFallbackCheckBox" Margin="18,8,0,0" VerticalContentAlignment="Center" Content="AI 失敗改用 FFmpeg" IsEnabled="{Binding IsAiFallbackEnabled}" IsChecked="{Binding FallbackToFfmpegWhenAiFails, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding DeepFilterNetStatusText}" />
                    <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding DeepFilterNetPathText}" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,8,0,0">
                      <Button Click="ChooseDeepFilterNet_Click" Content="指定 DFN" />
                      <Button Margin="8,0,0,0" Click="ClearDeepFilterNet_Click" Content="清除" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="人聲修復（VoiceFixer）" />
                    <CheckBox Margin="0,0,0,0" VerticalContentAlignment="Center" Content="VoiceFixer 人聲修復" IsChecked="{Binding EnableVoiceFixerDereverb, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="VoiceFixer 模式" />
                    <ComboBox x:Name="VoiceFixerModeSelector" IsEnabled="{Binding IsVoiceFixerModeEnabled}" SelectedIndex="{Binding VoiceFixerMode, Mode=TwoWay}">
                      <ComboBoxItem Content="0 - 標準模型" />
                      <ComboBoxItem Content="1 - 加強預處理" />
                      <ComboBoxItem Content="2 - 訓練模式" />
                    </ComboBox>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="人聲修復混合比例" />
                    <Grid x:Name="VoiceFixerMixControls" IsEnabled="{Binding EnableVoiceFixerDereverb}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="88" />
                      </Grid.ColumnDefinitions>
                      <Slider Minimum="0" Maximum="1" TickFrequency="0.05" SmallChange="0.05" IsSnapToTickEnabled="True" Value="{Binding VoiceFixerMix, Mode=TwoWay}" />
                      <TextBox Grid.Column="1" Margin="8,0,0,0" HorizontalContentAlignment="Right" IsReadOnly="True" Text="{Binding VoiceFixerMix, Mode=OneWay, StringFormat=P0}" />
                    </Grid>
                    <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding VoiceFixerStatusText}" />
                    <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding VoiceFixerPathText}" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,8,0,0">
                      <Button Click="ChooseVoiceFixer_Click" Content="指定 VoiceFixer" />
                      <Button Margin="8,0,0,0" Click="ClearVoiceFixer_Click" Content="清除" />
                    </WrapPanel>
                  </StackPanel>
                </Expander>
                <Expander Margin="0,18,0,8" Header="聲道與平衡" HorizontalAlignment="Stretch">
                  <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="聲道模式" />
                    <ComboBox ItemsSource="{Binding ChannelModes}" SelectedItem="{Binding SelectedChannelMode, Mode=TwoWay}" DisplayMemberPath="DisplayName" />
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="左右平衡（-1 左 / 0 中 / 1 右）" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="88" />
                      </Grid.ColumnDefinitions>
                      <Slider VerticalAlignment="Center" IsEnabled="{Binding IsStereoBalanceEnabled}" Minimum="-1" Maximum="1" TickFrequency="0.1" SmallChange="0.1" LargeChange="0.25" IsSnapToTickEnabled="True" Value="{Binding StereoBalance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                      <TextBox Grid.Column="1" VerticalAlignment="Center" IsEnabled="{Binding IsStereoBalanceEnabled}" HorizontalContentAlignment="Right" Margin="8,0,0,0" Text="{Binding StereoBalance, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.00}" />
                    </Grid>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="輸出設定" IsEnabled="{Binding CanStartWork}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,6,8,8">
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="輸出設定" />
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0" Text="{Binding OutputScopeText}" />
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="輸出格式" />
                <ComboBox ItemsSource="{Binding OutputFormats}" SelectedItem="{Binding SelectedOutputFormat, Mode=TwoWay}" DisplayMemberPath="DisplayName" />
                <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding OutputFolderText}" TextWrapping="Wrap" />
                <WrapPanel Margin="0,0,0,8">
                  <Button Click="ChooseOutputFolder_Click" Content="輸出位置" IsEnabled="{Binding CanStartWork}" />
                  <Button Click="OpenOutputFolder_Click" Content="開啟輸出" />
                  <Button Click="OpenProcessedFile_Click" Content="開處理後檔" IsEnabled="{Binding CanExportSelection}" />
                </WrapPanel>
                <TextBlock Text="檔案與整集" Style="{StaticResource SectionTitleStyle}" />
                <CheckBox Margin="0,0,0,0" VerticalContentAlignment="Center" Content="統整成單一檔案" IsChecked="{Binding MergeSegments, Mode=TwoWay}" />
                <Expander Margin="0,14,0,8" Header="整集與片頭片尾" HorizontalAlignment="Stretch" IsEnabled="{Binding MergeSegments}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="段落間空白秒數（0 - 10 秒）" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="88" />
                      </Grid.ColumnDefinitions>
                      <Slider VerticalAlignment="Center" Minimum="0" Maximum="10" TickFrequency="0.1" SmallChange="0.1" LargeChange="1" IsSnapToTickEnabled="True" Value="{Binding MergeGapSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                      <TextBox Grid.Column="1" VerticalAlignment="Center" HorizontalContentAlignment="Right" Margin="8,0,0,0" Text="{Binding MergeGapSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.0}" />
                    </Grid>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="統整輸出檔名" />
                    <TextBox Text="{Binding MergedOutputFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="標題" />
                    <TextBox Text="{Binding PodcastTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="作者 / 主持人" />
                    <TextBox Text="{Binding PodcastArtist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="節目 / 專輯名稱" />
                    <TextBox Text="{Binding PodcastAlbum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding CoverImageText}" />
                    <StackPanel Orientation="Horizontal">
                      <Button Click="ChooseCoverImage_Click" Content="選封面" />
                      <Button Margin="8,0,0,0" Click="ClearCoverImage_Click" Content="清除封面" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding IntroAudioText}" />
                    <StackPanel Orientation="Horizontal">
                      <Button Click="ChooseIntroAudio_Click" Content="選片頭" />
                      <Button Margin="8,0,0,0" Click="ClearIntroAudio_Click" Content="清除片頭" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="片頭淡入秒數（0 - 10 秒）" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="88" />
                      </Grid.ColumnDefinitions>
                      <Slider VerticalAlignment="Center" Minimum="0" Maximum="10" TickFrequency="0.1" SmallChange="0.1" LargeChange="1" IsSnapToTickEnabled="True" Value="{Binding IntroFadeSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                      <TextBox Grid.Column="1" VerticalAlignment="Center" HorizontalContentAlignment="Right" Margin="8,0,0,0" Text="{Binding IntroFadeSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.0}" />
                    </Grid>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding OutroAudioText}" />
                    <StackPanel Orientation="Horizontal">
                      <Button Click="ChooseOutroAudio_Click" Content="選片尾" />
                      <Button Margin="8,0,0,0" Click="ClearOutroAudio_Click" Content="清除片尾" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="片尾淡出秒數（0 - 10 秒）" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="88" />
                      </Grid.ColumnDefinitions>
                      <Slider VerticalAlignment="Center" Minimum="0" Maximum="10" TickFrequency="0.1" SmallChange="0.1" LargeChange="1" IsSnapToTickEnabled="True" Value="{Binding OutroFadeSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                      <TextBox Grid.Column="1" VerticalAlignment="Center" HorizontalContentAlignment="Right" Margin="8,0,0,0" Text="{Binding OutroFadeSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.0}" />
                    </Grid>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="波形分析">
            <ScrollViewer x:Name="PlaybackPanelScroll" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,6,8,8">
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="原音波形 / 剪輯定位" />
                <WrapPanel>
                  <Button Click="LoadWaveform_Click" Content="讀取原音波形" IsEnabled="{Binding CanStartWork}" />
                  <Button Click="CancelAnalysis_Click" Content="取消讀取" IsEnabled="{Binding IsAnalyzing}" />
                  <Button Click="SetTrimStartFromWaveform_Click" Content="游標設為起點" />
                  <Button Click="SetTrimEndFromWaveform_Click" Content="游標設為終點" />
                </WrapPanel>
                <controls:AudioWaveformView x:Name="OriginalWaveform" Height="96" Margin="0,8,0,6" AutomationProperties.Name="原音波形" AutomationProperties.HelpText="點擊定位原音，方向鍵移動一秒，Home 與 End 移至兩端" />
                <TextBlock Text="{Binding WaveformText}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock x:Name="WorkSessionHeading" Style="{StaticResource SectionTitleStyle}" Text="工作設定" />
                <TextBox Text="{Binding WorkSessionText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="54" MaxHeight="110" VerticalScrollBarVisibility="Auto" />
                <Button Click="RelinkWorkAudio_Click" Content="重新指定選取音檔" IsEnabled="{Binding CanStartWork}" />
                <TextBlock x:Name="EpisodeReviewHeading" Style="{StaticResource SectionTitleStyle}" Text="整集成品驗收" />
                <TextBlock Text="{Binding EpisodePreviewText}" TextWrapping="Wrap" />
                <Button Click="PlayEpisode_Click" Content="播放上次整集" IsEnabled="{Binding CanReviewEpisode}" />
                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding EpisodeChapters}" IsEnabled="{Binding CanReviewEpisode}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Content="{Binding DisplayText}" Tag="{Binding StartSeconds}" Click="EpisodeChapter_Click" HorizontalContentAlignment="Left" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="品質分析" />
                <WrapPanel Margin="0,0,0,8">
                  <Button Click="AnalyzeOriginal_Click" Content="分析原始" IsEnabled="{Binding CanStartWork}" />
                  <Button Click="AnalyzeProcessed_Click" Content="分析處理後" IsEnabled="{Binding CanStartWork}" />
                  <Button Click="CancelAnalysis_Click" Content="取消分析" IsEnabled="{Binding IsAnalyzing}" />
                </WrapPanel>
                <TextBox MinHeight="124" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding AnalysisText}" />
                <TextBlock Text="{Binding ProcessingWarningsText}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{StaticResource MutedTextBrush}" />
                <Expander Margin="0,18,0,0" HorizontalAlignment="Stretch" Header="工具設定">
                  <StackPanel>
                    <WrapPanel Margin="0,0,0,8">
                      <Button Click="ChooseFfmpeg_Click" Content="指定 FFmpeg" IsEnabled="{Binding CanStartWork}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource MetaTextStyle}" Text="{Binding FfmpegPathText}" TextWrapping="Wrap" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Border>
      <GridSplitter VerticalAlignment="Stretch" Grid.Column="1" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Center" ResizeDirection="Columns" Background="#292C2F" Width="4" x:Name="WorkspaceSplitter" ToolTip="調整清單與設定寬度" />
    </Grid>
  </DockPanel>
</Window>
