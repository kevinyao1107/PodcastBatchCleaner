<Window x:Class="PodcastBatchCleanerWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="音檔批次調整工具"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        Background="#090B10"
        Foreground="#EEF2F7"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#090B10" />
        <SolidColorBrush x:Key="PanelBrush" Color="#121722" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#171D2A" />
        <SolidColorBrush x:Key="BorderBrushDark" Color="#2B3342" />
        <SolidColorBrush x:Key="TextBrush" Color="#EEF2F7" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9AA4B2" />
        <SolidColorBrush x:Key="AccentBrush" Color="#36C2A6" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#4AD8BC" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#1F9D87" />
        <SolidColorBrush x:Key="ButtonBrush" Color="#222A38" />
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#2E384A" />
        <SolidColorBrush x:Key="ButtonPressedBrush" Color="#1A202B" />
        <SolidColorBrush x:Key="InputBrush" Color="#0D111A" />
        <SolidColorBrush x:Key="SelectionBrush" Color="#243D4A" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource ButtonBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#667085" />
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="31" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#101828" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#07100E" />
                                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource BorderBrushDark}" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,10" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,12,0,6" />
        </Style>

        <Style x:Key="MetaTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#0F141E" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="8"
                                Margin="6,2"
                                Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#1B2330" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource SelectionBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Background="{StaticResource AppBackgroundBrush}">
        <Border DockPanel.Dock="Top"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushDark}"
                BorderThickness="0,0,0,1"
                Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel>
                    <Button Click="SelectFolder_Click" Content="選取資料夾" />
                </WrapPanel>

                <TextBlock Grid.Column="1"
                           Margin="8,0"
                           VerticalAlignment="Center"
                           Text="{Binding CurrentFolderText}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource MutedTextBrush}" />

                <WrapPanel Grid.Column="2" HorizontalAlignment="Right">
                    <Button Click="ProcessSelected_Click"
                            Content="處理選取"
                            Background="{StaticResource AccentBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            Foreground="#07100E" />
                    <Button Click="ProcessAll_Click"
                            Content="全部輸出"
                            Background="{StaticResource AccentBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            Foreground="#07100E" />
                    <Button Click="CancelProcessing_Click" Content="取消" />
                </WrapPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Height="38"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrushDark}"
                BorderThickness="0,1,0,0"
                Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           Text="{Binding StatusText}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource MutedTextBrush}" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Width="220"
                               VerticalAlignment="Center"
                               Text="{Binding CurrentProcessingFileText}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <ProgressBar Width="180"
                                 Height="10"
                                 Margin="10,0,8,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ProcessingProgress}" />
                    <TextBlock Width="42"
                               VerticalAlignment="Center"
                               Text="{Binding ProcessingProgressText}"
                               TextAlignment="Right"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" MinWidth="560" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1*" MinWidth="330" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushDark}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="14,12"
                            Background="{StaticResource PanelAltBrush}"
                            BorderBrush="{StaticResource BorderBrushDark}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="12,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="資料夾音檔清單" />
                            <Button Grid.Column="1"
                                    MinHeight="28"
                                    Padding="10,4"
                                    Click="MoveSelectedUp_Click"
                                    Content="上移" />
                            <Button Grid.Column="2"
                                    MinHeight="28"
                                    Padding="10,4"
                                    Click="MoveSelectedDown_Click"
                                    Content="下移" />
                            <Button Grid.Column="3"
                                    MinHeight="28"
                                    Padding="10,4"
                                    Click="OpenSelectedFolder_Click"
                                    Content="開原檔位置" />
                            <TextBlock Grid.Column="4"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="{Binding FileCountText}" />
                        </Grid>
                    </Border>

                    <ListView x:Name="AudioList"
                              Grid.Row="1"
                              AllowDrop="True"
                              ItemsSource="{Binding AudioFiles}"
                              SelectionMode="Extended"
                              SelectionChanged="AudioList_SelectionChanged"
                              PreviewMouseLeftButtonDown="AudioList_PreviewMouseLeftButtonDown"
                              MouseMove="AudioList_MouseMove"
                              Drop="AudioList_Drop"
                              MouseDoubleClick="AudioList_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="180" Header="檔名" DisplayMemberBinding="{Binding FileName}" />
                                <GridViewColumn Width="68" Header="長度" DisplayMemberBinding="{Binding DurationText}" />
                                <GridViewColumn Width="90" Header="狀態" DisplayMemberBinding="{Binding Status}" />
                                <GridViewColumn Width="82" Header="開始">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox MinWidth="58"
                                                     Padding="6,2"
                                                     HorizontalContentAlignment="Right"
                                                     Text="{Binding TrimStartText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="可輸入秒數或 mm:ss，例如 12.5 或 01:23" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="82" Header="結束">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox MinWidth="58"
                                                     Padding="6,2"
                                                     HorizontalContentAlignment="Right"
                                                     Text="{Binding TrimEndText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="留空代表處理到音檔結尾" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="150" Header="輸出檔名">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox MinWidth="120"
                                                     Padding="6,2"
                                                     Text="{Binding CustomOutputFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="不填會自動使用原檔名加 _processed" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="170" Header="處理後檔案" DisplayMemberBinding="{Binding ProcessedFileName}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrushDark}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14">
                <TabControl>
                    <TabItem Header="處理">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,14,12,0">
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Text="處理設定" />

                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="處理模板" />
                                <WrapPanel Margin="0,0,0,2">
                            <Button Margin="0,0,8,8"
                                    Click="ApplyPodcastPreset_Click"
                                    Content="一般 Podcast" />
                            <Button Margin="0,0,8,8"
                                    Click="ApplyRoomTonePreset_Click"
                                    Content="空間音重" />
                            <Button Margin="0,0,8,8"
                                    Click="ApplyThinVoicePreset_Click"
                                    Content="聲音偏薄" />
                            <Button Margin="0,0,8,8"
                                    Click="ApplyTrimOnlyPreset_Click"
                                    Content="只剪輯" />
                                </WrapPanel>

                                <WrapPanel Margin="0,8,0,4">
                                    <Button Click="PreviewSelected_Click" Content="30秒試聽" />
                                    <Button Click="CompareSelected_Click" Content="A/B 比較" />
                                </WrapPanel>

                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="空拍超過多久刪除（0.1 - 1.0 秒）" />
                                <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SilenceSecondsSlider"
                                    VerticalAlignment="Center"
                                    Minimum="0.1"
                                    Maximum="1"
                                    TickFrequency="0.1"
                                    SmallChange="0.1"
                                    LargeChange="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding SilenceSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="1"
                                     VerticalAlignment="Center"
                                     HorizontalContentAlignment="Right"
                                     Margin="8,0,0,0"
                                     Text="{Binding SilenceSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.0}" />
                                </Grid>

                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="空拍判定門檻 dBFS" />
                                <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <Slider VerticalAlignment="Center"
                                    Minimum="-80"
                                    Maximum="-5"
                                    TickFrequency="1"
                                    Value="{Binding SilenceThresholdDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="1"
                                     VerticalAlignment="Center"
                                     HorizontalContentAlignment="Right"
                                     Margin="8,0,0,0"
                                     Text="{Binding SilenceThresholdDb, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0}" />
                                </Grid>

                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="輸出格式" />
                                <ComboBox ItemsSource="{Binding OutputFormats}"
                                          SelectedItem="{Binding SelectedOutputFormat, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="AI / 音質">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,14,12,0">
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Text="AI / 音質" />

                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="AI 降噪" />
                                <CheckBox Margin="0,0,0,0"
                                  VerticalContentAlignment="Center"
                                  Content="使用 AI 處理後音檔"
                                  IsChecked="{Binding UseAiProcessedAudio, Mode=TwoWay}" />

                        <CheckBox Margin="0,10,0,0"
                                  VerticalContentAlignment="Center"
                                  Content="DeepFilterNet AI 降噪"
                                  IsChecked="{Binding EnableDeepFilterNet, Mode=TwoWay}" />

                        <CheckBox Margin="18,8,0,0"
                                  VerticalContentAlignment="Center"
                                  Content="DeepFilterNet PostFilter"
                                  IsChecked="{Binding EnableDeepFilterNetPostFilter, Mode=TwoWay}" />

                        <CheckBox Margin="18,8,0,0"
                                  VerticalContentAlignment="Center"
                                  Content="AI 失敗改用 FFmpeg"
                                  IsChecked="{Binding FallbackToFfmpegWhenAiFails, Mode=TwoWay}" />

                        <TextBlock Style="{StaticResource MetaTextStyle}"
                                   Text="{Binding DeepFilterNetStatusText}" />
                        <TextBlock Style="{StaticResource MetaTextStyle}"
                                   Text="{Binding DeepFilterNetPathText}" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Click="ChooseDeepFilterNet_Click" Content="指定 DFN" />
                            <Button Margin="8,0,0,0"
                                    Click="ClearDeepFilterNet_Click"
                                    Content="清除" />
                        </WrapPanel>

                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="聲音補強" />
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="聲道模式" />
                        <ComboBox ItemsSource="{Binding ChannelModes}"
                                  SelectedItem="{Binding SelectedChannelMode, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="左右平衡（-1 左 / 0 中 / 1 右）" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <Slider VerticalAlignment="Center"
                                    Minimum="-1"
                                    Maximum="1"
                                    TickFrequency="0.1"
                                    SmallChange="0.1"
                                    LargeChange="0.25"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding StereoBalance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="1"
                                     VerticalAlignment="Center"
                                     HorizontalContentAlignment="Right"
                                     Margin="8,0,0,0"
                                     Text="{Binding StereoBalance, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.00}" />
                        </Grid>

                        <CheckBox Margin="0,0,0,0"
                                  VerticalContentAlignment="Center"
                                  Content="統一降噪"
                                  IsChecked="{Binding EnableDenoise, Mode=TwoWay}" />

                        <CheckBox Margin="0,10,0,0"
                                  VerticalContentAlignment="Center"
                                  Content="減少空間音"
                                  IsChecked="{Binding ReduceRoomTone, Mode=TwoWay}" />

                        <CheckBox Margin="0,10,0,0"
                                  VerticalContentAlignment="Center"
                                  Content="去殘響"
                                  IsChecked="{Binding ReduceReverb, Mode=TwoWay}" />

                        <CheckBox Margin="0,10,0,0"
                                  VerticalContentAlignment="Center"
                                  Content="人聲增厚 EQ"
                                  IsChecked="{Binding EnhanceVoiceEq, Mode=TwoWay}" />

                        <CheckBox Margin="0,10,0,0"
                                  VerticalContentAlignment="Center"
                                  Content="Podcast 響度標準化 (-16 LUFS)"
                                  IsChecked="{Binding NormalizeLoudness, Mode=TwoWay}" />

                        <CheckBox Margin="0,10,0,0"
                                  VerticalContentAlignment="Center"
                                  Content="防爆音 Limiter"
                                  IsChecked="{Binding EnableLimiter, Mode=TwoWay}" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="音量增益 dB" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <Slider VerticalAlignment="Center"
                                    Minimum="-24"
                                    Maximum="24"
                                    TickFrequency="0.5"
                                    SmallChange="0.5"
                                    LargeChange="3"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding VolumeGainDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="1"
                                     VerticalAlignment="Center"
                                     HorizontalContentAlignment="Right"
                                     Margin="8,0,0,0"
                                     Text="{Binding VolumeGainDb, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.0}" />
                        </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="統整">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,14,12,0">
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Text="統整輸出" />

                                <CheckBox Margin="0,0,0,0"
                                  VerticalContentAlignment="Center"
                                  Content="統整成單一檔案"
                                  IsChecked="{Binding MergeSegments, Mode=TwoWay}" />

                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="段落間空白秒數（0 - 10 秒）" />
                                <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <Slider VerticalAlignment="Center"
                                    Minimum="0"
                                    Maximum="10"
                                    TickFrequency="0.1"
                                    SmallChange="0.1"
                                    LargeChange="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding MergeGapSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="1"
                                     VerticalAlignment="Center"
                                     HorizontalContentAlignment="Right"
                                     Margin="8,0,0,0"
                                     Text="{Binding MergeGapSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.0}" />
                                </Grid>

                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="統整輸出檔名" />
                        <TextBox Text="{Binding MergedOutputFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="標題" />
                        <TextBox Text="{Binding PodcastTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="作者 / 主持人" />
                        <TextBox Text="{Binding PodcastArtist, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="節目 / 專輯名稱" />
                        <TextBox Text="{Binding PodcastAlbum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="{Binding CoverImageText}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Click="ChooseCoverImage_Click" Content="選封面" />
                            <Button Margin="8,0,0,0"
                                    Click="ClearCoverImage_Click"
                                    Content="清除封面" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="{Binding IntroAudioText}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Click="ChooseIntroAudio_Click" Content="選片頭" />
                            <Button Margin="8,0,0,0"
                                    Click="ClearIntroAudio_Click"
                                    Content="清除片頭" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="片頭淡入秒數（0 - 10 秒）" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <Slider VerticalAlignment="Center"
                                    Minimum="0"
                                    Maximum="10"
                                    TickFrequency="0.1"
                                    SmallChange="0.1"
                                    LargeChange="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding IntroFadeSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="1"
                                     VerticalAlignment="Center"
                                     HorizontalContentAlignment="Right"
                                     Margin="8,0,0,0"
                                     Text="{Binding IntroFadeSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.0}" />
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="{Binding OutroAudioText}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Click="ChooseOutroAudio_Click" Content="選片尾" />
                            <Button Margin="8,0,0,0"
                                    Click="ClearOutroAudio_Click"
                                    Content="清除片尾" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="片尾淡出秒數（0 - 10 秒）" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="88" />
                            </Grid.ColumnDefinitions>
                            <Slider VerticalAlignment="Center"
                                    Minimum="0"
                                    Maximum="10"
                                    TickFrequency="0.1"
                                    SmallChange="0.1"
                                    LargeChange="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding OutroFadeSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="1"
                                     VerticalAlignment="Center"
                                     HorizontalContentAlignment="Right"
                                     Margin="8,0,0,0"
                                     Text="{Binding OutroFadeSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.0}" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="工具 / 播放">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,14,12,0">
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Text="工具 / 播放" />

                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="播放" />

                        <TextBlock Margin="0,0,0,6"
                                   Text="{Binding SelectedFileText}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}" />

                        <ComboBox Margin="0,4,0,12"
                                  SelectedIndex="{Binding PlaybackSourceIndex, Mode=TwoWay}"
                                  SelectionChanged="PlaybackSource_SelectionChanged">
                            <ComboBoxItem Content="播放原始音檔" />
                            <ComboBoxItem Content="播放處理後音檔" />
                        </ComboBox>

                        <StackPanel Orientation="Horizontal">
                            <Button Click="Play_Click" Content="播放" />
                            <Button Click="Pause_Click" Content="暫停" />
                            <Button Click="Stop_Click" Content="停止" />
                                </StackPanel>

                        <Slider x:Name="PositionSlider"
                                Margin="0,14,0,4"
                                Minimum="0"
                                Maximum="1"
                                PreviewMouseDown="PositionSlider_PreviewMouseDown"
                                PreviewMouseUp="PositionSlider_PreviewMouseUp"
                                ValueChanged="PositionSlider_ValueChanged" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PlaybackPositionText}" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding PlaybackDurationText}" Foreground="{StaticResource MutedTextBrush}" />
                        </Grid>

                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="品質分析" />
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Click="AnalyzeOriginal_Click" Content="分析原始" />
                                    <Button Click="AnalyzeProcessed_Click" Content="分析處理後" />
                                </WrapPanel>
                                <TextBox MinHeight="124"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding AnalysisText}" />

                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="工具與位置" />
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Click="ChooseOutputFolder_Click" Content="輸出位置" />
                                    <Button Click="OpenOutputFolder_Click" Content="開啟輸出" />
                                    <Button Click="OpenSelectedFolder_Click" Content="開原檔位置" />
                                    <Button Click="OpenProcessedFile_Click" Content="開處理後檔" />
                                </WrapPanel>
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Click="ChooseAiAudioFolder_Click" Content="AI 音檔資料夾" />
                                    <Button Click="ChooseFfmpeg_Click" Content="指定 FFmpeg" />
                                </WrapPanel>

                        <TextBlock Style="{StaticResource MetaTextStyle}"
                                   Text="{Binding FfmpegPathText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource MetaTextStyle}"
                                   Text="{Binding OutputFolderText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource MetaTextStyle}"
                                   Text="{Binding AiAudioFolderText}"
                                   TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </DockPanel>
</Window>
